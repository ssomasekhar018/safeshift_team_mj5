# ===========================
# SafeShift - .gitignore
# ===========================

# ----------------------------
# Node.js / npm
# ----------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json
yarn.lock
pnpm-lock.yaml

# ----------------------------
# Frontend (Vite / React)
# ----------------------------
dist/
build/
.vite/
*.local

# ----------------------------
# Environment Variables (NEVER commit these)
# ----------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ----------------------------
# Python / ML
# ----------------------------
__pycache__/
.pytest_cache/
pytest_cache/
.hypothesis/
tests/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
.installed.cfg
MANIFEST

# Virtual environments
venv/
env/
ENV/
.venv/
.env/
Pipfile.lock

# Jupyter Notebooks
.ipynb_checkpoints

# ----------------------------
# ML Models & Large Data Files
# ----------------------------
*.h5
*.pkl
*.joblib
*.pt
*.pth
*.ckpt
*.bin
*.onnx
safeshift/ml/models/*.h5
safeshift/ml/models/*.pkl
safeshift/ml/models/*.pt

# Datasets
*.csv
*.tsv
*.parquet
*.npy
*.npz
safeshift/ml/train/data/

# ----------------------------
# Server / Database
# ----------------------------
safeshift/server/data/
safeshift/server/db/*.sqlite
safeshift/server/db/*.db
*.sqlite
*.db

# ----------------------------
# Tests (User request to ignore)
# ----------------------------
**/__tests__/
**/test/
**/*.test.js
**/*.test.jsx
**/*.spec.js
**/*.spec.jsx
**/*.test.py
**/*.spec.py

# Logs
logs/
*.log

# ----------------------------
# OS & Editor Files
# ----------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# VS Code
.vscode/
!.vscode/extensions.json

# JetBrains / IntelliJ
.idea/
*.iml
*.iws

# ----------------------------
# Misc
# ----------------------------
*.tmp
*.temp
*.swp
*.bak
.cache/
coverage/
.nyc_output/
