# SafeShift Environment Configuration
NODE_ENV=development
PORT=4000

# JWT
JWT_SECRET=your-secret-key-here

# Client
CLIENT_URL=http://localhost:5173

# OpenWeatherMap (free tier — https://openweathermap.org/api)
OPENWEATHER_API_KEY=demo_key

# AQICN (free tier — https://aqicn.org/data-platform/token/)
AQICN_API_KEY=demo_key

# Razorpay (sandbox — https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_ACCOUNT_NUMBER=

# ML Service
ML_SERVICE_URL=http://localhost:8000
